# --- Stripe ---
# Live-Secret-Key aus dem Stripe-Dashboard.
# Path: Stripe Dashboard → Entwickler → API-Schlüssel → "Geheimer Schlüssel"
# Backend braucht read access auf checkout.sessions (für /zugang-Verifikation),
# darum NICHT der Restricted Key, sondern der volle Secret Key.
STRIPE_SECRET_KEY=sk_test_xxx

# Webhook-Signing-Secret. Wird beim Anlegen des Webhook-Endpoints generiert.
# Path: Stripe Dashboard → Entwickler → Webhooks → [Endpoint] → "Signing secret"
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Vollständige Payment-Link-URL aus dem Stripe-Dashboard.
# Path: Stripe Dashboard → Payment Links → Founder OS → "URL kopieren"
# Wird im Frontend an die Buy-Buttons gebunden. Muss mit NEXT_PUBLIC_ prefixed
# sein, damit es client-side verfügbar ist.
NEXT_PUBLIC_STRIPE_PAYMENT_LINK_URL=https://buy.stripe.com/xxxxxxxx

# --- JWT (Magic-Link-Signing) ---
# Geheimer Schlüssel für die Magic-Link-Tokens. Mindestens 32 Zeichen.
# Generieren mit: openssl rand -base64 48
# Wenn dieser Wert geändert wird, sind alle aktiven Käufer-Zugänge ungültig.
JWT_SECRET=replace_me_with_a_long_random_string_min_32_chars

# --- Site URL (für Magic-Link-Erstellung) ---
NEXT_PUBLIC_SITE_URL=https://founder-os.bb-brands.de
